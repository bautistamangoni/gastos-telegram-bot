# Telegram Bot Token obtenido desde @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_tu_token_aqui

# Tu ID numérico de usuario de Telegram (podés obtenerlo escribiéndole a @userinfobot)
ALLOWED_USER_ID=123456789

# API Key de Gemini obtenida desde https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy_tu_api_key_aqui

# Modelo de Gemini a utilizar (opcional, por defecto gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ID de tu Google Sheet (la parte entre /d/ y /edit en la URL de la planilla)
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Ruta al archivo JSON de la Service Account de Google Cloud
GOOGLE_CREDENTIALS_PATH=credentials.json

# Zona horaria local (opcional, por defecto America/Argentina/Buenos_Aires)
TIMEZONE=America/Argentina/Buenos_Aires
